{
  "name": "jjewa-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "dev": "node src/server.js",
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "check": "node --check src/server.js && node --check src/app.js",
    "test": "node test/security.test.js",
    "test:integration": "node test/database.integration.test.js",
    "test:leadops": "node test/leadops.database.integration.test.js",
    "auth:bootstrap-admin": "node scripts/bootstrap-admin.mjs",
    "ai:configure": "node scripts/configure-ai.mjs",
    "db:migrate": "node ../database/scripts/apply-migrations.mjs",
    "db:verify": "node ../database/scripts/verify-schema.mjs"
  },
  "dependencies": {
    "axios": "1.16.1",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "4.22.2",
    "mssql": "10.0.4",
    "socket.io": "4.8.3",
    "xlsx": "0.18.5"
  }
}
